{
  "id": "render-markup",
  "name": "Render Markup",
  "short_name": "Markup",
  "description": "Mark up architectural renders and PDFs with pill callouts, leader lines, sketches and dimensions. Images and PDFs never leave your computer.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#efefef",
  "theme_color": "#efefef",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [".pdf"],
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/webp": [".webp"]
      }
    }
  ],
  "launch_handler": { "client_mode": "navigate-new" },
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "files", "accept": ["application/pdf", ".pdf", "image/png", "image/jpeg", "image/webp"] }
      ]
    }
  }
}
